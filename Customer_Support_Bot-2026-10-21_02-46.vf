    {
      "id": "6ad7c67dca9f529b7b851260",
      "name": "Untitled playbook",
      "createdByID": 2101814,
      "folderID": null,
      "settings": {},
      "description": null,
      "instructions": [
        {
          "text": [
            {
              "text": [
                {
                  "text": [
                    "১. কাস্টমারকে স্বাগতম জানাও। যদি সে মিটিং বা অ্যাপয়েন্টমেন্ট বুক করতে চায়, তবে তার কাছ থেকে নাম (name) এবং ইমেইল অ্যাড্রেস (email) চেয়ে নাও।"
                  ],
                  "attributes": {
                    "__type": "text",
                    "italic": true
                  }
                }
              ]
            },
            {
              "text": [
                ""
              ]
            },
            {
              "text": [
                {
                  "text": [
                    "২. নাম ও ইমেইল পাওয়ার পর, সাথে সাথে ডানদিকের "
                  ],
                  "attributes": {
                    "__type": "text",
                    "italic": true
                  }
                },
                {
                  "text": [
                    "Make"
                  ],
                  "attributes": {
                    "code": true,
                    "__type": "text",
                    "italic": true
                  }
                },
                {
                  "text": [
                    " টুলটি ব্যবহার করে ডাটা পাঠিয়ে দাও।"
                  ],
                  "attributes": {
                    "__type": "text",
                    "italic": true
                  }
                }
              ]
            }
          ],
          "attributes": {
            "__type": "blockquote"
          }
        }
      ],
