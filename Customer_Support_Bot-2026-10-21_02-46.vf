              "messages": null
            }
          ],
          "flowTools": [],
          "pathTools": [],
          "instructions": "> _১. কাস্টমারকে স্বাগতম জানাও। যদি সে মিটিং বা অ্যাপয়েন্টমেন্ট বুক করতে চায়, তবে তার কাছ থেকে নাম (name) এবং ইমেইল অ্যাড্রেস (email) চেয়ে নাও।_\n>\n>\n>\n> _২. নাম ও ইমেইল পাওয়ার পর, সাথে সাথে ডানদিকের __`Make`__ টুলটি ব্যবহার করে ডাটা পাঠিয়ে দাও।_",
          "functionTools": [],
          "callForwardTool": null,
          "integrationTools": [],
          "knowledgeBaseTool": {
            "enabled": true,
            "messages": null,
            "description": "",
            "toolSound": null
          },
          "hasToolNameWarning": false,
          "mcpIntegrationTools": []
        }
      },
      "prompts": {},
      "apiTools": {
        "6ad7c752ca9f529b7b851272": {
          "name": "Send Data to Make",
          "description": "কাস্টমারের কাছ থেকে নাম (name) এবং ইমেইল (email) পাওয়ার পর এই টুলটি ব্যবহার করো।",
          "apiCall": {
            "url": "https://hook.eu1.make.com/dv7f30usyenfxxsch753llmk89x66tep",
            "body": [],
            "method": "POST",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "val": "application/json"
              }
            ],
            "content": "{\n  \"name\": \"{name}\",\n  \"email\": \"{email}\"\n}\n",
            "bodyInputType": "rawInput",
            "selected_action": "Make a POST Request"
          },
          "toolName": "send_data_to_make",
          "inputVariables": {},
          "hasToolNameWarning": false
        }
      },
